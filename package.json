{
  "name": "docs-version-deploy",
  "version": "6.0.0",
  "description": "Deploy versioned static documentation to any GitHub repository",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "types": "./dist/index.d.ts",
    "import": "./dist/index.js",
    "require": "./dist/index.cjs"
  },
  "scripts": {
    "test": "echo npx vitest run --reporter verbose --coverage",
    "format": "prettier --write **/*.{ts,json,yml,css,html}",
    "format:check": "prettier --check **/*.{ts,json,yml,css,html}",
    "lint": "eslint src/**/*.ts",
    "typecheck:workspace": "tsc -p tsconfig.workspace.json",
    "build": "npm run build:assets && npm run build:action",
    "build:assets": "tsup --config tsup.assets.config.ts ",
    "build:assets:public": "tsup --config tsup.assets.public.config.ts",
    "build:action": "tsup --config tsup.action.config.ts",
    "build:action:public": "tsup --config tsup.action.public.config.ts",
    "build:public": "npm run build:assets:public && npm run build:action:public && npm run assemble:static-content",
    "docs": "npx typedoc",
    "assemble:static-content": "tsx workspace/scripts/assembleStaticContent.ts",
    "prepare:artifact": "tsx workspace/release/prepareArtifact.ts",
    "prepare": "is-ci || husky"
  },
  "files": [
    "dist/*",
    "CHANGELOG.md"
  ],
  "keywords": [
    "docs-version-deploy"
  ],
  "author": "Yuki_akai",
  "homepage": "https://github.com/yukiakai212/docs-version-deploy",
  "funding": "https://github.com/sponsors/yukiakai212",
  "engines": {
    "node": ">= 16"
  },
  "maintainers": [
    {
      "name": "Yuki_akai",
      "homepage": "https://github.com/yukiakai212"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yukiakai212/docs-version-deploy.git"
  },
  "bugs": {
    "url": "https://github.com/yukiakai212/docs-version-deploy/issues"
  },
  "license": "MIT",
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@eslint/js": "^9.30.1",
    "@types/node": "^24.0.10",
    "@types/parse-github-url": "^1.0.3",
    "@types/semver": "^7.8.0",
    "@vitest/coverage-v8": "^4.0.15",
    "dotenv": "^17.0.1",
    "eslint": "^9.30.0",
    "husky": "^9.1.7",
    "is-ci": "^4.1.0",
    "prettier": "^3.6.2",
    "serve": "^14.2.8",
    "tsup": "^8.5.1",
    "tsx": "^4.20.3",
    "typedoc": "^0.28.9",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.1",
    "vitest": "^4.0.15"
  },
  "dependencies": {
    "@actions/core": "^3.0.0",
    "@yukiakai/actions-git": "^6.0.0",
    "@yukiakai/path-extra": "^1.0.1",
    "@yukiakai/zod-extra": "^1.0.1",
    "@yukiakai/artifact": "^2.0.1",
    "parse-github-url": "^1.0.4",
    "semver": "^7.8.6",
    "zod": "^4.3.6"
  }
}
